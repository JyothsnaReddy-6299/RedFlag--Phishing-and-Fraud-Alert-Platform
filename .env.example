# RedFlag environment template.
# Copy to backend/.env and fill in locally. NEVER commit a real .env.

# --- Core ------------------------------------------------------------------
PROJECT_NAME="RedFlag Threat Intelligence Platform"

# --- Database --------------------------------------------------------------
# SQLite (default, zero-config demo):
#   sqlite:///./redflag.db
# PostgreSQL (deployment):
#   postgresql+psycopg://user:password@host:5432/redflag
REDFLAG_DATABASE_URL=sqlite:///./redflag.db

# --- Security / abuse prevention -------------------------------------------
REDFLAG_RATE_ANALYZE=30          # analyze requests per IP per minute
REDFLAG_RATE_REPORT=10           # report submissions per IP per minute
REDFLAG_RATE_READ=240            # read requests per IP per minute
REDFLAG_MAX_UPLOAD_BYTES=8388608 # 8 MB image upload ceiling
REDFLAG_MAX_BODY_BYTES=10485760  # 10 MB request body ceiling

# --- CORS ------------------------------------------------------------------
# Comma-free JSON list. Lock this down in production.
# BACKEND_CORS_ORIGINS=["https://redflag.example.org"]

# --- Optional external services --------------------------------------------
# No live reputation feed is wired up in this build. If you connect one,
# put its key here and surface it in /api/health as a real dependency.
GEMINI_API_KEY=
